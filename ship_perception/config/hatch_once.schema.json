{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "pipeline_version",
    "input",
    "scene_context",
    "pipeline_health",
    "stage_elapsed",
    "runtime",
    "geometry_only",
    "intensity_fusion",
    "intensity_status",
    "per_vessel_status",
    "rejected_exterior_candidates",
    "rejected_outside_vessel",
    "software_git_sha",
    "software_source_identity",
    "config_sha256",
    "scene_exterior_low_regions",
    "per_hatch_status",
    "per_side_uncertainty",
    "grid_phase_stability",
    "undercoverage_risk"
  ],
  "properties": {
    "schema": {
      "enum": [
        "ship_perception.hatch_once.2",
        "ship_perception.hatch_once.3"
      ]
    },
    "input": {
      "type": "object",
      "required": [
        "semantic_sha256",
        "point_count",
        "frame_id",
        "provenance"
      ]
    },
    "scene_context": {
      "type": "object",
      "required": [
        "b1_execution_count",
        "vessels"
      ],
      "properties": {
        "b1_execution_count": {
          "const": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "transport"
      ]
    },
    "pipeline_health": {
      "type": "object",
      "required": [
        "status",
        "first_failure_stage",
        "isolated_failures"
      ]
    },
    "stage_elapsed": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "geometry_only": {},
    "intensity_fusion": {},
    "per_hatch_status": {
      "type": "object"
    },
    "per_side_uncertainty": {
      "type": "object"
    },
    "grid_phase_stability": {
      "type": "object"
    },
    "undercoverage_risk": {
      "type": "object"
    },
    "scene_exterior_low_regions": {
      "type": "object"
    },
    "intensity_status": {
      "type": "object"
    },
    "software_source_identity": {
      "type": "object"
    },
    "per_vessel_status": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vessel_hypothesis_id",
          "status",
          "independent_groups",
          "aggregate_summary"
        ],
        "properties": {
          "unresolved_review_proposals": {
            "type": "object",
            "required": [
              "total_count",
              "samples",
              "omitted_count",
              "all_records_sha256"
            ],
            "properties": {
              "total_count": {
                "type": "integer",
                "minimum": 0
              },
              "omitted_count": {
                "type": "integer",
                "minimum": 0
              },
              "all_records_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "samples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "status",
                    "reason",
                    "proposal_id",
                    "geometry_role",
                    "proposal_boundary_uv",
                    "proposal_boundary_xy",
                    "precision_admitted"
                  ],
                  "properties": {
                    "status": {
                      "const": "UNRESOLVED"
                    },
                    "geometry_role": {
                      "const": "UNREFINED_REVIEW_PROPOSAL_NOT_STEEL"
                    },
                    "precision_admitted": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "hatch_count",
        "hatches",
        "intensity_used"
      ],
      "properties": {
        "hatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "hatches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hatch"
          }
        },
        "intensity_used": {
          "type": "boolean"
        }
      }
    },
    "hatch": {
      "type": "object",
      "required": [
        "hatch_id",
        "status",
        "boundary_xy",
        "boundary_uv",
        "best_estimate_boundary_xy",
        "review_coverage_boundary_xy",
        "vessel_hypothesis_id",
        "sides",
        "corners",
        "undercoverage_risk",
        "per_side_uncertainty",
        "candidate_blockers",
        "input_frame",
        "vessel_local_axes",
        "corner_geometry"
      ],
      "properties": {
        "sides": {
          "type": "object",
          "required": [
            "U0",
            "U1",
            "V0",
            "V1"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "rho_before_m",
              "rho_after_m",
              "side_inward_move_m",
              "boundary_uncertainty_m",
              "support_section_count",
              "grid_phase",
              "raw_source_scope",
              "undercoverage_risk",
              "steel_edge_certified"
            ],
            "properties": {
              "steel_edge_certified": {
                "const": false
              }
            }
          }
        },
        "boundary_xy": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4
        },
        "undercoverage_risk": {
          "type": "boolean"
        }
      }
    },
    "review_hatch": {
      "type": "object",
      "required": [
        "hatch_id",
        "opening_identity",
        "topology_status",
        "geometry_status",
        "certification_status",
        "review_polygon_xy",
        "review_coverage_polygon_xy",
        "sides",
        "corners",
        "corner_heights",
        "boundary_xy",
        "undercoverage_risk"
      ],
      "properties": {
        "geometry_status": {
          "const": "COMPLETE_REVIEW_GEOMETRY"
        },
        "steel_edge_certified": {
          "const": false
        },
        "corners": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4
        },
        "corner_heights": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "z_m",
              "z_state",
              "z_observed",
              "z_estimate",
              "z_source",
              "source_point_indexes",
              "source_segment_ids"
            ],
            "properties": {
              "z_state": {
                "enum": [
                  "MEASURED",
                  "ESTIMATED",
                  "UNOBSERVED"
                ]
              },
              "z_m": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "sides": {
          "type": "object",
          "required": [
            "U0",
            "U1",
            "V0",
            "V1"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "final_rho",
              "final_state",
              "final_source",
              "rho_before",
              "rho_after",
              "movement_m",
              "candidate_modes",
              "selected_mode_id",
              "rejected_mode_ids",
              "movement_reason",
              "guard_result",
              "raw_support_ids",
              "s4_family_ids",
              "topology_support_ids",
              "height_support_ids",
              "uncertainty_m"
            ]
          }
        }
      }
    },
    "review_result": {
      "type": "object",
      "required": [
        "hatch_count",
        "hatches",
        "intensity_used"
      ],
      "properties": {
        "hatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "hatches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_hatch"
          }
        },
        "intensity_used": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "ship_perception.hatch_once.2"
          }
        }
      },
      "then": {
        "properties": {
          "geometry_only": {
            "$ref": "#/$defs/result"
          },
          "intensity_fusion": {
            "$ref": "#/$defs/result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "ship_perception.hatch_once.3"
          }
        }
      },
      "then": {
        "properties": {
          "geometry_only": {
            "$ref": "#/$defs/review_result"
          },
          "intensity_fusion": {
            "$ref": "#/$defs/review_result"
          }
        },
        "required": [
          "schema_version",
          "producer_git_sha",
          "runtime_source_hash",
          "config_hash",
          "input_sha256",
          "review_mode"
        ]
      }
    }
  ]
}
