<?xml version="1.0"?>
<package format="3">
  <name>ship_perception</name>
  <version>0.1.0</version>
  <description>One-frame hatch review and preserved C++ ship tracking core.</description>
  <maintainer email="maintainers@ship-unloader.local">Ship-Unloader maintainers</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>eigen</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>std_msgs</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
