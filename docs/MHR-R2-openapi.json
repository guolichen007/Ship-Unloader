{
  "openapi": "3.1.0",
  "info": {
    "title": "MHR local workbench",
    "version": "2.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "LoopbackToken": []
    }
  ],
  "components": {
    "securitySchemes": {
      "LoopbackToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-MHR-Token"
      }
    }
  },
  "paths": {
    "/api/v2/auto/confirm": {
      "post": {
        "responses": {
          "200": {
            "description": "Bound workbench result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "steel_certified",
                    "control_eligible"
                  ],
                  "properties": {
                    "steel_certified": {
                      "const": false
                    },
                    "control_eligible": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Origin, Host or token rejected"
          },
          "409": {
            "description": "Stale frame, candidate or revision"
          },
          "413": {
            "description": "Body budget exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "annotation_id",
                  "bundle_digest",
                  "expected_parent_revision",
                  "frame_id",
                  "frame_instance_id",
                  "geometry_digest",
                  "manifest_sha256",
                  "mutation_id",
                  "semantic_sha256",
                  "session_id",
                  "view_id",
                  "wire_sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "annotation_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_:-]{1,64}$"
                  },
                  "bundle_digest": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "expected_parent_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "frame_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "frame_instance_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_:-]{1,64}$"
                  },
                  "geometry_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "manifest_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "mutation_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_:-]{1,64}$"
                  },
                  "semantic_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "session_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_:-]{1,64}$"
                  },
                  "view_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_:-]{1,64}$"
                  },
                  "wire_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    },
