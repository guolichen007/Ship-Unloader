          "frame_instance_id",
          "view_id",
          "manifest_sha256",
          "wire_sha256",
          "semantic_sha256",
          "frame_id",
          "request_id",
          "annotation_id"
        ]
      },
      "Preview": {
        "type": "object",
        "properties": {
          "steel_certified": {
            "const": false
          },
          "control_eligible": {
            "const": false
          },
          "execution_state": {
            "type": "string"
          },
          "match_state": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "list_digest": {
            "$ref": "#/components/schemas/Digest"
          },
          "draft_digest": {
            "$ref": "#/components/schemas/Digest"
          },
          "selection_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "search_complete": {
            "type": "boolean"
          },
          "geometry": {
            "type": [
              "object",
              "null"
            ]
          },
          "recommendation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidate_id": {
                  "type": "string"
                },
                "geometry_digest": {
                  "$ref": "#/components/schemas/Digest"
                },
                "confirmable": {
                  "type": "boolean"
                },
                "geometry": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
