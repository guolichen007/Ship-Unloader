          },
          "bundle_digest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Digest"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "type": "string"
          },
          "list_digest": {
            "$ref": "#/components/schemas/Digest"
          },
          "draft_digest": {
            "$ref": "#/components/schemas/Digest"
          },
          "side_id": {
            "enum": [
              "V0",
              "U1",
              "V1",
              "U0"
            ]
          }
        },
        "required": [
          "session_id",
          "frame_instance_id",
          "view_id",
          "manifest_sha256",
          "wire_sha256",
          "semantic_sha256",
          "frame_id",
          "annotation_id",
          "expected_parent_revision",
          "bundle_digest",
          "request_id",
          "list_digest",
          "draft_digest",
          "side_id"
        ]
      },
      "Cancel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string"
          },
          "frame_instance_id": {
            "type": "string"
          },
          "view_id": {
            "type": "string"
          },
          "manifest_sha256": {
            "$ref": "#/components/schemas/Digest"
          },
          "wire_sha256": {
            "$ref": "#/components/schemas/Digest"
          },
          "semantic_sha256": {
            "$ref": "#/components/schemas/Digest"
          },
          "frame_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "annotation_id": {
            "type": "string"
          }
        },
        "required": [
